<tr class="receipt-row"
    data-controller="modal"
    data-action="click->modal#open"
    data-modal-dialog-id-param="receipt_dialog_<%= receipt.id %>">
  <td>
    <% if receipt.file.present? %>
      <% if receipt.image_file? %>
        <%= image_tag receipt_file_path(receipt), alt: "Receipt", style: "border-radius: 4px; max-width: 60px; max-height: 60px;" %>
      <% else %>
        <span class="icon"><i class="fas fa-file-pdf"></i></span>
        <%= File.basename(receipt.file.path) %>
      <% end %>
    <% end %>
  </td>
  <td><%= receipt.effective_date.strftime("%B %d, %Y") %></td>
  <td>
    <% if receipt.recorded? %>
      <span class="tag is-success"><%= t("recorded", scope: "receipts.receipt") %></span>
      <span class="tag is-light"><%= t("code", scope: "receipts.receipt", code: receipt.code) %></span>
    <% else %>
      <span class="tag is-warning"><%= t("unrecorded", scope: "receipts.receipt") %></span>
    <% end %>
  </td>
  <td data-no-modal>
    <% unless receipt.recorded? %>
      <div class="buttons are-small">
        <%= link_to t("edit", scope: "receipts.receipt"), edit_receipt_path(receipt), class: "button is-small" %>
        <%= button_to t("delete", scope: "receipts.receipt"), receipt_path(receipt), method: :delete,
            form: { data: { turbo_confirm: t("confirm_delete", scope: "receipts.receipt") } },
            class: "button is-small is-danger" %>
      </div>
    <% end %>
  </td>
</tr>
