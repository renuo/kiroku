<h1 class="title"><%= t("title", scope: "receipts.edit") %></h1>

<div class="box">
  <%= form_with model: @receipt, url: receipt_path(@receipt) do |f| %>
    <div class="field">
      <%= f.label :spent_on, t("spent_on", scope: "receipts.form"), class: "label" %>
      <div class="control">
        <%= f.date_field :spent_on, class: "input" %>
      </div>
    </div>

    <div class="field">
      <div class="control">
        <%= f.submit t("submit", scope: "receipts.form"), class: "button is-primary" %>
      </div>
    </div>
  <% end %>
</div>
