<dialog id="receipt_dialog_<%= receipt.id %>" class="receipt-modal" onclick="if(event.target===this)this.close()">
  <div class="receipt-modal-content box">
    <div class="has-text-right">
      <button type="button" class="delete" aria-label="close" onclick="this.closest('dialog').close()"></button>
    </div>

    <% if receipt.file.present? %>
      <div data-controller="zoom">
        <div class="zoom-toolbar buttons are-small is-centered mb-2">
          <button type="button" class="button" data-action="zoom#zoomIn" title="Zoom in">+</button>
          <button type="button" class="button" data-action="zoom#reset" title="Reset zoom">1:1</button>
          <button type="button" class="button" data-action="zoom#zoomOut" title="Zoom out">&minus;</button>
        </div>
        <div class="zoom-container">
          <%= image_tag preview_receipt_file_path(receipt), alt: "Receipt", class: "receipt-modal-image",
              loading: "lazy", data: { zoom_target: "image" } %>
        </div>
      </div>
    <% end %>

    <p class="mt-4 has-text-grey">
      <%= receipt.user.name %> — <%= receipt.effective_date.strftime("%B %d, %Y") %>
    </p>

    <div class="mt-4">
      <% if local_assigns[:admin] %>
        <% if receipt.recorded? %>
          <div class="level">
            <div class="level-left">
              <span class="tag is-success is-medium mr-2"><%= t("recorded", scope: "receipts.receipt") %></span>
              <span class="tag is-light is-medium"><%= t("code", scope: "receipts.receipt", code: receipt.code) %></span>
            </div>
            <div class="level-right">
              <%= button_to t("unrecord", scope: "admin.receipts.form"),
                  unrecord_admin_receipt_path(receipt), method: :patch,
                  class: "button is-warning",
                  form: { data: { turbo_frame: "_top" } } %>
            </div>
          </div>
        <% else %>
          <%= form_with url: record_admin_receipt_path(receipt), method: :patch,
              data: { turbo_frame: "_top" } do |f| %>
            <div class="field has-addons">
              <div class="control is-expanded">
                <%= f.text_field :code, placeholder: t("code", scope: "admin.receipts.form"),
                    required: true, class: "input", name: "code" %>
              </div>
              <div class="control">
                <%= f.submit t("record", scope: "admin.receipts.form"), class: "button is-success" %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <% if receipt.recorded? %>
          <span class="tag is-success is-medium mr-2"><%= t("recorded", scope: "receipts.receipt") %></span>
          <span class="tag is-light is-medium"><%= t("code", scope: "receipts.receipt", code: receipt.code) %></span>
        <% else %>
          <div class="buttons">
            <%= link_to t("edit", scope: "receipts.receipt"), edit_receipt_path(receipt), class: "button" %>
            <%= button_to t("delete", scope: "receipts.receipt"), receipt_path(receipt), method: :delete,
                form: { data: { turbo_confirm: t("confirm_delete", scope: "receipts.receipt") } },
                class: "button is-danger" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</dialog>
